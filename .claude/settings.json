{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rtk-einrichten.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.local/bin/rtk\" ]; then \"$HOME/.local/bin/rtk\" hook claude; fi; exit 0"
          }
        ]
      }
    ]
  }
}
